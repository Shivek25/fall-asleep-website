---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}
import '../styles/global.css';
import Starfield from '../components/Starfield.astro';
const { 
  title, 
  description = 'Having trouble sleeping? Discover proven ways to fall asleep faster. Fall asleep fast using cognitive shuffling, guided breathing, and grounding exercises.',
  image = '/favicon.svg',
  canonicalURL = 'https://fallasleep.app/' // Assuming a default canonical URL base
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Fall Asleep</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — Fall Asleep`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Fall Asleep" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} — Fall Asleep`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Starfield />
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>

    <slot name="nav" />
  </body>
</html>



<style is:global>
  /* Global Page Styles for MPA Text Pages (About, Contact, Privacy, Terms) */
  .page-container {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    min-height: calc(100vh - 150px);
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .back-link {
    color: var(--color-drift-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1rem;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-drift-text);
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-drift-text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .page-content {
    color: var(--color-drift-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .page-content h2 {
    color: var(--color-drift-text);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .page-content p, .page-content ul {
    margin-bottom: 1.5rem;
  }
  .page-content li {
    margin-bottom: 0.5rem;
  }
  .page-content a {
    color: var(--color-drift-accent-glow);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .page-content a:hover {
    opacity: 0.8;
  }
</style>
