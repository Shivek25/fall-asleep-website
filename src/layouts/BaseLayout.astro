---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Starfield from '../components/Starfield.astro';
import AmbientPlayer from '../components/AmbientPlayer.tsx';
const { 
  title, 
  description = 'Having trouble sleeping? Discover proven ways to fall asleep faster. Fall asleep fast using cognitive shuffling, guided breathing, and grounding exercises.',
  image = '/favicon.svg',
  canonicalURL = 'https://fallasleep.app/' // Assuming a default canonical URL base
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Fall Asleep</title>
    <ClientRouter />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} - Fall Asleep`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Fall Asleep" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} - Fall Asleep`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V9GSTD21FS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V9GSTD21FS');
    </script>
  </head>
  <body>
    <Starfield transition:persist />
    <AmbientPlayer client:load transition:persist />
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
    <footer class="global-footer">
      <div class="global-footer__inner">
        <nav class="global-footer__links">
          <a href="/">Home</a>
          <span class="separator">•</span>
          <a href="/about">About Us</a>
          <span class="separator">•</span>
          <a href="/privacy-policy">Privacy</a>
          <span class="separator">•</span>
          <a href="/terms">Terms</a>
          <span class="separator">•</span>
          <a href="/contact">Contact</a>
        </nav>
        <p class="global-footer__privacy">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          All data stays on your device. No accounts, no cloud, no tracking.
        </p>
      </div>
    </footer>

    <slot name="nav" />
  </body>
</html>



<style>
  .global-footer {
    padding: 3rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 2rem;
  }
  .global-footer__inner {
    max-width: 42rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .global-footer__links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .global-footer__links a {
    color: var(--color-drift-text-dim);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  .global-footer__links a:hover {
    color: var(--color-drift-text);
  }
  .global-footer__links .separator {
    color: rgba(255, 255, 255, 0.15);
    font-size: 0.875rem;
    user-select: none;
    transform: translateY(-1px);
    display: inline-block;
  }
  .global-footer__privacy {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: var(--color-drift-text-dim);
    margin: 0;
  }
</style>

<style is:global>
  /* Global Page Styles for MPA Text Pages (About, Contact, Privacy, Terms) */
  .page-container {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
    min-height: calc(100vh - 150px);
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .back-link {
    color: var(--color-drift-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1rem;
    display: inline-block;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-drift-text);
  }
  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-drift-text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .page-content {
    color: var(--color-drift-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .page-content h2 {
    color: var(--color-drift-text);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .page-content p, .page-content ul {
    margin-bottom: 1.5rem;
  }
  .page-content li {
    margin-bottom: 0.5rem;
  }
  .page-content a {
    color: var(--color-drift-accent-glow);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .page-content a:hover {
    opacity: 0.8;
  }
</style>
