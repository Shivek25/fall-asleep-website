---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/shuffle/', label: 'Shuffle', icon: 'shuffle' },
  { href: '/journal/', label: 'Journal', icon: 'journal' },
  { href: '/breathe/', label: 'Breathe', icon: 'breathe' },
  { href: '/meditate/', label: 'Meditate', icon: 'meditate' },
  { href: '/calm/', label: 'Calm', icon: 'calm' },
  { href: '/checkin/', label: 'Check-in', icon: 'checkin' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="drift-nav" role="navigation" aria-label="Main navigation">
  <ul class="drift-nav__list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['drift-nav__link', { 'drift-nav__link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="drift-nav__icon" aria-hidden="true" data-icon={item.icon}>
            {item.icon === 'home' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            )}
            {item.icon === 'shuffle' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            )}
            {item.icon === 'journal' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            )}
            {item.icon === 'breathe' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
            )}
            {item.icon === 'meditate' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="2"/><path d="M12 8v5"/><path d="M7 13a4 4 0 0 0-4 4 2 2 0 0 0 2 2h14a2 2 0 0 0 2-2 4 4 0 0 0-4-4"/><path d="M9 13l3 3 3-3"/></svg>
            )}
            {item.icon === 'calm' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            )}
            {item.icon === 'checkin' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            )}
          </span>
          <span class="drift-nav__label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .drift-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(15, 17, 23, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .drift-nav__list {
    display: flex;
    justify-content: space-around;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0.3125rem 0.125rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .drift-nav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.3125rem 0.25rem;
    min-width: 38px;
    min-height: 42px;
    border-radius: 0.625rem;
    text-decoration: none;
    color: var(--color-drift-text-dim);
    font-size: 0.59375rem;
    font-weight: 500;
    transition: color 0.2s ease;
    justify-content: center;
  }

  .drift-nav__link:hover {
    color: var(--color-drift-text-muted);
  }

  .drift-nav__link--active {
    color: var(--color-drift-accent);
  }

  .drift-nav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drift-nav__label {
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>
