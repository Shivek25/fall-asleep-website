---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import BackButton from '../components/BackButton.astro';
import Journal from '../components/Journal.tsx';
---

<BaseLayout title="Brain Dump" description="Write down your thoughts and let them go. Everything stays private on your device.">
  <div class="page">
    <div class="page__header">
      <BackButton />
      <h1 class="page__title">Brain Dump</h1>
      <p class="page__desc">Write it down, lock it away, let it go</p>
    </div>
    <Journal client:load />
  </div>
  <Navigation slot="nav" />
</BaseLayout>

<style>
  .page {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem 0.5rem 6rem;
  }

  .page__header {
    margin-bottom: 0.5rem;
    padding: 0 0.5rem;
  }

  .page__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    color: var(--color-drift-text);
  }

  .page__desc {
    font-size: 0.875rem;
    color: var(--color-drift-text-muted);
    margin: 0;
  }
</style>
