---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import BackButton from '../components/BackButton.astro';
import CircuitBreaker from '../components/CircuitBreaker.tsx';
---

<BaseLayout title="Circuit Breaker" description="Instant calm when anxiety strikes. Grounding exercises, calming words, and gentle guidance to break the cycle.">
  <div class="page">
    <div class="page__header">
      <BackButton />
      <h1 class="page__title">Circuit Breaker</h1>
      <p class="page__desc">Instant calm when you need it</p>
    </div>
    <CircuitBreaker client:load />
  </div>
  <Navigation slot="nav" />
</BaseLayout>

<style>
  .page {
    max-width: 32rem;
    margin: 0 auto;
    padding: 1rem 0.5rem 6rem;
  }

  .page__header {
    margin-bottom: 0.5rem;
    padding: 0 0.5rem;
  }

  .page__title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    color: var(--color-drift-text);
  }

  .page__desc {
    font-size: 0.875rem;
    color: var(--color-drift-text-muted);
    margin: 0;
  }
</style>
