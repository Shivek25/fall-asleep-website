    font-size: 0.8125rem;
    user-select: none;
    display: inline-block;
    transform: translateY(-1px);
  }

  .home__features {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .home__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    min-height: 72px;
  }

  .home__card--urgent {
    border: 1px solid rgba(212, 164, 74, 0.2);
