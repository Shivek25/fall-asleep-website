  <Navigation slot="nav" />
</BaseLayout>

<style>
  .home {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem 6rem;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .home__header {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .home__moon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(255, 200, 50, 0.3));
  }

  .home__title {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, var(--color-drift-text) 0%, var(--color-drift-accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .home__subtitle {
    font-size: 0.9375rem;
    color: var(--color-drift-text-muted);
    margin: 0.375rem 0 0;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .home__hero-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home__hero-links a {
    color: var(--color-drift-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.2s ease;
  }
  .home__hero-links a:hover {
    color: var(--color-drift-text);
  }
  .home__hero-links .separator {
    color: rgba(255, 255, 255, 0.15);
    font-size: 0.8125rem;
    user-select: none;
    display: inline-block;
    transform: translateY(-1px);
  }

  .home__features {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .home__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    min-height: 72px;
  }

  .home__card--urgent {
    border: 1px solid rgba(212, 164, 74, 0.2);
    order: -1;
  }

  .home__card-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-drift-surface-raised);
    border-radius: 0.75rem;
  }

  .home__card-content {
    flex: 1;
    min-width: 0;
  }

  .home__card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-drift-text);
  }

  .home__card-desc {
    font-size: 0.8125rem;
    color: var(--color-drift-text-muted);
    margin: 0.125rem 0 0;
    line-height: 1.4;
  }

  .home__card-arrow {
    flex-shrink: 0;
    color: var(--color-drift-text-dim);
    transition: transform 0.2s ease;
  }

  .home__card:hover .home__card-arrow {
    transform: translateX(2px);
    color: var(--card-accent);
  }

  /* Global footer styles moved to BaseLayout.astro */

  @media (prefers-reduced-motion: reduce) {
    .home__card-arrow {
      transition: none;
    }
  }

  .seo-article {
    background: var(--color-drift-bg);
    padding: 6rem 1.5rem 8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.03);
    position: relative;
    z-index: 10;
  }

  .seo-article__inner {
    max-width: 42rem; /* ~65 characters wide for comfortable reading */
    margin: 0 auto;
    color: var(--color-drift-text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .seo-article__inner h2, .seo-article__inner h3 {
    color: var(--color-drift-text);
    font-weight: 600;
    margin: 3rem 0 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .seo-article__inner h2 {
    font-size: 1.75rem;
    margin-top: 0;
  }

  .seo-article__inner h3 {
