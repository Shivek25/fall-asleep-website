  <Navigation slot="nav" />
</BaseLayout>

<style>
  .home {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem 6rem;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .home__header {
    text-align: center;
    padding: 2rem 0 2.5rem;
  }

  .home__moon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(255, 200, 50, 0.3));
  }

  .home__title {
    font-size: 2.5rem;
