  }

  .faq-item summary {
    font-weight: 500;
    color: var(--color-drift-text);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 2rem;
    outline: none;
  }
  
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
